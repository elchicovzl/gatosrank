# ---------------------------------------------------------------------------
# topcats.lol — variables de entorno
#
# Para desarrollo local:   cp env.example .env
# ---------------------------------------------------------------------------

# Base de datos.
# En local el proyecto usa un contenedor dedicado en el puerto 5434:
#   docker run -d --name topcats-db \
#     -e POSTGRES_PASSWORD=topcats -e POSTGRES_USER=topcats -e POSTGRES_DB=topcats \
#     -p 5434:5432 postgres:16-alpine
DATABASE_URL="postgresql://topcats:topcats@localhost:5434/topcats?schema=public"

# URL pública del sitio. La usa la imagen OG y todos los links absolutos.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Panel /admin. En producción: token largo y aleatorio.
#   openssl rand -hex 32
ADMIN_TOKEN="dev-token-cambiame"

# --- Pagos -----------------------------------------------------------------
# "mock"  -> proveedor simulado, sin salir a internet (dev)
# "polar" -> Polar real (merchant of record)
PAYMENTS_PROVIDER="mock"
POLAR_ACCESS_TOKEN=""
POLAR_PRODUCT_ID=""
POLAR_WEBHOOK_SECRET=""
# "sandbox" | "production"
POLAR_SERVER="sandbox"

# --- Almacenamiento de imágenes -------------------------------------------
# Sin credenciales de R2 el proyecto guarda en .uploads/ y sirve por
# /api/uploads/[key]. Suficiente para desarrollo; en Vercel es obligatorio R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Dominio público del bucket, sin barra final. Ej: https://cdn.topcats.lol
R2_PUBLIC_URL=""

# --- Moderación de imágenes ------------------------------------------------
# "permissive" -> aprueba todo (SOLO dev)
# "review"     -> manda todo a revisión manual en /admin (default seguro)
MODERATION_PROVIDER="permissive"
