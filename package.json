    "@prisma/client": "^7.9.1",
    "clsx": "^2.1.1",
    "file-type": "^22.0.2",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
